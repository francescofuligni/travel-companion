<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/nav_home">

    <fragment
        android:id="@+id/nav_home"
        android:name="com.example.travelcompanion.ui.home.HomeFragment"
        android:label="@string/menu_home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/nav_new_trip"
        android:name="com.example.travelcompanion.ui.newtrip.NewTripFragment"
        android:label="@string/start_trip_title"
        tools:layout="@layout/fragment_new_trip" />

    <!-- History Screen -->
    <fragment
        android:id="@+id/nav_history"
        android:name="com.example.travelcompanion.ui.history.HistoryFragment"
        android:label="@string/menu_history"
        tools:layout="@layout/fragment_history" />

    <!-- Stats Screen -->
    <fragment
        android:id="@+id/nav_stats"
        android:name="com.example.travelcompanion.ui.stats.StatsFragment"
        android:label="@string/menu_stats"
        tools:layout="@layout/fragment_stats" />

    <!-- Settings Screen -->
    <fragment
        android:id="@+id/nav_settings"
        android:name="com.example.travelcompanion.ui.settings.SettingsFragment"
        android:label="@string/menu_settings"
        tools:layout="@layout/fragment_settings" />

</navigation>