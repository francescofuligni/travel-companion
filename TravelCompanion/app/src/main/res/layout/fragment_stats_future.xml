<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/futureStatsLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:orientation="vertical">

    <TextView
        android:id="@+id/textNextMonth"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Prossimo mese:"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textColor="@android:color/black" />

    <TextView
        android:id="@+id/textPredictedTrips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Aspettativa numero viaggi: ..."
        android:layout_marginTop="8dp"
        android:textSize="16sp" />

    <com.github.mikephil.charting.charts.LineChart
        android:id="@+id/futureTripsChart"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="8dp" />

    <LinearLayout
        android:id="@+id/trendTripsBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:layout_marginTop="8dp"
        android:background="@android:color/holo_red_light">

        <TextView
            android:id="@+id/textTrendTripsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Trend: in calo"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/black" />

        <TextView
            android:id="@+id/textTrendTripsMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cerca nuove esperienze e viaggia di più!"
            android:textSize="14sp"
            android:textColor="@android:color/black" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="24dp" />

    <TextView
        android:id="@+id/textPredictedKm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Aspettativa distanza da percorrere: ..."
        android:layout_marginTop="24dp"
        android:textSize="16sp" />

    <com.github.mikephil.charting.charts.LineChart
        android:id="@+id/futureKmChart"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="8dp" />

    <LinearLayout
        android:id="@+id/trendKmBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:layout_marginTop="8dp"
        android:background="@android:color/holo_red_light">

        <TextView
            android:id="@+id/textTrendKmTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Trend: in calo"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/black" />

        <TextView
            android:id="@+id/textTrendKmMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Non ti arrendere, guarda oltre i tuoi orizzonti!"
            android:textSize="14sp"
            android:textColor="@android:color/black" />
    </LinearLayout>
</LinearLayout>